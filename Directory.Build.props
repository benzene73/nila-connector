<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <!-- Published versions are supplied by the release tag, never edited here. -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(ConnectorRelease)' != 'true'">dev</VersionSuffix>
    <Company>KaguyaHQ</Company>
    <Product>Nila Connector</Product>
    <Copyright>Copyright © KaguyaHQ</Copyright>
  </PropertyGroup>
</Project>
