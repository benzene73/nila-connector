<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NilaConnector.Core\NilaConnector.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NilaConnector.Desktop.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\nila.ico</ApplicationIcon>
    <ApplicationTitle>Nila Connector</ApplicationTitle>
    <AssemblyName>NilaConnector</AssemblyName>
    <RootNamespace>NilaConnector.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\nila.ico" />
  </ItemGroup>

  <!-- WPF also evaluates this file as a generated *_wpftmp project. Record the
       checkout only for the real project, outside that temporary compilation. -->
  <Target Name="RecordConnectorBuild" BeforeTargets="GetAssemblyAttributes"
          Condition="'$(MSBuildProjectName)' == 'NilaConnector.Desktop'">
    <Exec Command="git status --porcelain --untracked-files=normal"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="Low"
          Condition="Exists('$(MSBuildProjectDirectory)/../../.git')">
      <Output TaskParameter="ConsoleOutput" ItemName="ConnectorWorkingTreeChanges" />
      <Output TaskParameter="ExitCode" PropertyName="ConnectorGitStatusExitCode" />
    </Exec>
    <PropertyGroup>
      <ConnectorHasLocalChanges Condition="'@(ConnectorWorkingTreeChanges)' != '' and '$(ConnectorGitStatusExitCode)' == '0'">true</ConnectorHasLocalChanges>
    </PropertyGroup>
    <Error Condition="'$(ConnectorRelease)' == 'true' and ('$(ConnectorHasLocalChanges)' == 'true' or '$(ConnectorGitStatusExitCode)' != '0')"
           Text="Release builds require a clean Git checkout." />
    <ItemGroup>
      <AssemblyMetadata Include="ConnectorRelease" Value="$(ConnectorRelease)" />
      <AssemblyMetadata Include="ConnectorHasLocalChanges" Value="$(ConnectorHasLocalChanges)" />
    </ItemGroup>
  </Target>

</Project>
