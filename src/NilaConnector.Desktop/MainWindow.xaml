<Window x:Class="NilaConnector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nila Connector"
        Width="720"
        Height="680"
        MinWidth="600"
        MinHeight="500"
        Icon="Assets/nila.ico"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F6F8FA">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="116" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#137BA8" />
            <Setter Property="BorderBrush" Value="#137BA8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Product header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="44" Height="44" Background="#004865" CornerRadius="10">
                <Viewbox Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="100" Height="100">
                        <Path Fill="#F5F1E8"
                              Data="M 50,10 A 40,40 0 0,1 50,90 A 58,58 0 0,0 50,10 Z" />
                    </Canvas>
                </Viewbox>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="#101828" Text="Nila Connector" />
                <TextBlock Margin="0,3,0,0" Foreground="#667085" Text="Tally bridge for this computer" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource QuietButton}"
                    Content="Settings" Click="Settings_Click" />
        </Grid>

        <!-- Connection state -->
        <Border Grid.Row="1" Margin="0,22,0,0" Padding="16,13" Background="White"
                BorderBrush="#DCE1E7" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding NilaColor}" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Foreground="#667085" FontSize="12" Text="NILA CLOUD" />
                        <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Foreground="#101828"
                                   Text="{Binding NilaStatus, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" Background="#EAECF0" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding TallyColor}" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Foreground="#667085" FontSize="12" Text="TALLYPRIME" />
                        <TextBlock Margin="0,2,0,0" FontWeight="SemiBold" Foreground="#101828"
                                   Text="{Binding TallyStatus, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="3" Margin="18,0,0,0" Style="{StaticResource PrimaryButton}"
                        Content="Link to Nila"
                        Visibility="{Binding ShowLinkButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                        IsEnabled="{Binding CanLink}"
                        Click="LinkNila_Click" />
            </Grid>
        </Border>

        <!-- Company section heading -->
        <StackPanel Grid.Row="2" Margin="0,24,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#101828" Text="Open companies" />
                <TextBlock Margin="8,0,0,2" VerticalAlignment="Bottom" Foreground="#667085"
                           Text="{Binding CompanyCountLabel, StringFormat=({0})}" />
            </StackPanel>
            <TextBlock Margin="0,3,0,0" Foreground="#667085"
                       Text="Only companies currently loaded in TallyPrime appear here." />
        </StackPanel>

        <!-- Company workspace -->
        <Grid Grid.Row="3">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                              Visibility="{Binding HasCompanies, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding Companies}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10" Padding="17,15" Background="White"
                                        BorderBrush="#DCE1E7" BorderThickness="1" CornerRadius="7">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#101828"
                                                   TextTrimming="CharacterEllipsis" Text="{Binding Name}" />

                                        <Button Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center"
                                                Style="{StaticResource PrimaryButton}"
                                                Content="{Binding SyncButtonText}"
                                                IsEnabled="{Binding CanSync}"
                                                Click="SyncNow_Click" />

                                        <StackPanel Grid.Row="1" Margin="0,11,18,0">
                                            <TextBlock Foreground="#667085" Text="{Binding Masters, StringFormat=Masters  ·  {0}}" />
                                            <TextBlock Margin="0,4,0,0" Foreground="#667085"
                                                       Text="{Binding Vouchers, StringFormat=Vouchers ·  {0}}" />
                                        </StackPanel>

                                        <Border Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10,7"
                                                Background="#FFF4F3" CornerRadius="5">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Error}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Error}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Foreground="#B42318" TextWrapping="Wrap" Text="{Binding Error}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasNoCompanies, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock HorizontalAlignment="Center" FontSize="16"
                               FontWeight="SemiBold" Foreground="#101828" Text="No open Tally company" />
                    <TextBlock Width="330" Margin="0,6,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="#667085" Text="Open a company in the configured TallyPrime instance." />
                </StackPanel>
        </Grid>

        <!-- Non-blocking activity message -->
        <TextBlock Grid.Row="4" Margin="2,13,0,0" Foreground="#667085"
                   TextWrapping="Wrap" Text="{Binding PairingMessage}" />
    </Grid>
</Window>
