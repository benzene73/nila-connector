<Window x:Class="NilaConnector.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nila Connector"
        Width="460"
        Height="390"
        MinWidth="420"
        MinHeight="340"
        WindowStartupLocation="CenterScreen"
        Background="#F7F7F8">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock FontSize="24" FontWeight="SemiBold" Text="Nila Connector" />

        <StackPanel Grid.Row="1" Margin="0,22,0,0">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Ellipse Width="10" Height="10" Fill="{Binding NilaColor}" Margin="0,0,10,0" />
                <TextBlock FontSize="14">
                    <Run Text="Nila " />
                    <Run FontWeight="SemiBold" Text="{Binding NilaStatus, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="{Binding TallyColor}" Margin="0,0,10,0" />
                <TextBlock FontSize="14">
                    <Run Text="Tally " />
                    <Run FontWeight="SemiBold" Text="{Binding TallyStatus, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" Margin="20,10,0,0" Foreground="#66666B"
                   TextWrapping="Wrap" Text="{Binding PairingMessage}" />

        <TextBlock Grid.Row="3" FontSize="17" FontWeight="SemiBold" Text="Companies" />

        <Border Grid.Row="4" Margin="0,12,0,20" Padding="18" Background="White"
                BorderBrush="#DEDEE2" BorderThickness="1" CornerRadius="6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Margin="0,0,0,12" Foreground="#66666B"
                           Text="{Binding CompanySummary}" />
                <ItemsControl ItemsSource="{Binding Companies}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,10" BorderBrush="#ECECEF" BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1" Foreground="#1F9D68" Text="Open" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button MinWidth="96" Height="32" Margin="0,0,8,0"
                    Content="{Binding LinkButtonText}"
                    IsEnabled="{Binding CanLink}"
                    Click="LinkNila_Click" />
            <Button MinWidth="92" Height="32" Content="Diagnostics" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
