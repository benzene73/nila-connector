<Window x:Class="NilaConnector.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nila Connector Settings"
        Width="520"
        Height="480"
        MinWidth="460"
        MinHeight="420"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F6F8FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#137BA8" />
            <Setter Property="BorderBrush" Value="#137BA8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#FDA29B" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Foreground="#101828" Text="Settings" />
            <TextBlock Margin="0,4,0,0" Foreground="#667085"
                       Text="Connection details and maintenance actions." />
        </StackPanel>

        <Border Grid.Row="1" Margin="0,22,0,0" Padding="16" Background="White"
                BorderBrush="#DCE1E7" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="#101828" Text="TallyPrime endpoint" />
                    <TextBlock Margin="0,3,0,0" Foreground="#667085" Text="Local HTTP/XML connection" />
                </StackPanel>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontFamily="Consolas"
                           Foreground="#344054" Text="127.0.0.1:9000" />

                <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Margin="0,14" Background="#EAECF0" />

                <StackPanel Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock FontWeight="SemiBold" Foreground="#101828" Text="Nila device" />
                    <TextBlock Margin="0,3,0,0" Foreground="#667085" Text="Secure credential stored for this Windows user" />
                </StackPanel>
                <TextBlock x:Name="DeviceStatusText" Grid.Row="2" Grid.Column="1" Margin="0,14,0,0"
                           VerticalAlignment="Top" FontWeight="SemiBold" Foreground="#087A51" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock FontWeight="SemiBold" Foreground="#101828" Text="Diagnostics" />
            <TextBlock Margin="0,4,0,10" Foreground="#667085" TextWrapping="Wrap"
                       Text="Logs contain connection events and sanitized errors. Credentials are never written to logs." />
            <Button HorizontalAlignment="Left" Style="{StaticResource QuietButton}"
                    Content="Open logs folder" Click="OpenLogs_Click" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Button x:Name="UnlinkButton" HorizontalAlignment="Left" Style="{StaticResource DangerButton}"
                    Content="Unlink this device"
                    Click="Unlink_Click" />
            <Button HorizontalAlignment="Right" MinWidth="86" Style="{StaticResource PrimaryButton}"
                    Content="Done" IsDefault="True"
                    Click="Done_Click" />
        </Grid>
    </Grid>
</Window>
