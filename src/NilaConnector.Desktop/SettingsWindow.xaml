<Window x:Class="NilaConnector.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nila Connector Settings"
        Width="540" Height="470" MinWidth="500" MinHeight="440"
        Icon="Assets/nila.ico"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF" Foreground="#101828" FontSize="14">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="Foreground" Value="#344054" />
        </Style>
        <Style x:Key="TextAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#137BA8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#004865" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#98A2B3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,12" />
            <Setter Property="Background" Value="#EAECF0" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,22,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Focusable="False">
            <StackPanel>
                <TextBlock FontWeight="SemiBold" Text="TallyPrime" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,5" Foreground="#667085" Text="Host" />
                    <TextBlock Grid.Column="2" Margin="0,0,0,5" Foreground="#667085" Text="Port" />
                    <TextBox x:Name="TallyHostTextBox" Grid.Row="1" AutomationProperties.Name="TallyPrime host" />
                    <TextBox x:Name="TallyPortTextBox" Grid.Row="1" Grid.Column="2" AutomationProperties.Name="TallyPrime port" />
                    <Button x:Name="SaveTallyButton" Grid.Row="1" Grid.Column="4"
                            Content="Save" Click="SaveTally_Click" />
                </Grid>
                <TextBlock x:Name="TallySaveStatusText" Foreground="#667085" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Margin" Value="0,8,0,0" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Border Style="{StaticResource Divider}" />
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Nila" />
                        <TextBlock x:Name="DeviceStatusText" Margin="12,0,0,0" />
                    </StackPanel>
                    <Button x:Name="UnlinkButton" HorizontalAlignment="Right" Style="{StaticResource TextAction}"
                            Foreground="#B42318" Content="Unlink" Click="Unlink_Click" />
                </Grid>

                <Border Style="{StaticResource Divider}" />
                <Grid>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Logs" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource TextAction}"
                            Content="Open folder" Click="OpenLogs_Click" />
                </Grid>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock FontWeight="SemiBold" Text="About" />
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BuildDetailsText" Foreground="#667085" VerticalAlignment="Center"
                                   Margin="0,0,12,0" TextWrapping="Wrap" />
                        <Button x:Name="CheckUpdatesButton" Grid.Column="1" Style="{StaticResource TextAction}"
                                Content="Check for updates" Click="CheckUpdates_Click" />
                    </Grid>
                    <Grid x:Name="UpdateStatusRow" Margin="0,2,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="UpdateStatusText" Foreground="#667085" TextWrapping="Wrap"
                                   VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="DownloadUpdateButton" Grid.Column="1" Margin="12,0,0,0"
                                Style="{StaticResource TextAction}" Visibility="Collapsed"
                                Content="Download update" Click="DownloadUpdate_Click" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Style="{StaticResource TextAction}" Content="Release notes"
                                Click="ReleaseNotes_Click" />
                        <TextBlock Margin="12,0" VerticalAlignment="Center" Foreground="#D0D5DD" Text="·" />
                        <Button x:Name="CopyBuildInfoButton" Style="{StaticResource TextAction}"
                                Content="Copy build info" Click="CopyBuildInfo_Click" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" HorizontalAlignment="Right" Margin="0,18,0,0" MinWidth="80"
                Background="#137BA8" BorderBrush="#137BA8" Foreground="White"
                Content="Done" IsDefault="True" IsCancel="True" Click="Done_Click" />
    </Grid>
</Window>
